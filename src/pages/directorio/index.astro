---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const herramientas = await getCollection('herramientas');
---

<Layout
  title="Directorio de Herramientas de Automatización IA"
  description="Explora las mejores herramientas y motores de automatización de flujos de trabajo para marketing, e-commerce y operaciones."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-3xl mb-12">
      <div class="text-xs font-bold uppercase tracking-wider text-brand-400 mb-2">Ecosistema Completo</div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        Directorio Curado de Herramientas
      </h1>
      <p class="text-base text-slate-400 leading-relaxed">
        Plataformas de automatización, scrapers, CRM de código abierto y motores de inteligencia artificial clasificados por tipo de licencia y casos de uso.
      </p>
    </div>

    <!-- Tools Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {herramientas.map((h) => (
        <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 flex flex-col justify-between hover:border-brand-500/40 hover:-translate-y-1 transition-all">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="text-3xl">{h.data.logo || '⚡'}</span>
              <div class="flex items-center gap-1.5">
                <span class="rounded-md bg-slate-800 px-2 py-0.5 text-xs text-slate-300">
                  {h.data.categoria}
                </span>
                <span class={`rounded-md px-2 py-0.5 text-xs font-semibold ${
                  h.data.licencia === 'Open-Source'
                    ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
                    : 'bg-indigo-500/10 text-indigo-400 border border-indigo-500/20'
                }`}>
                  {h.data.licencia}
                </span>
              </div>
            </div>

            <h3 class="text-lg font-bold text-white mb-2">{h.data.nombre}</h3>
            <p class="text-xs text-slate-400 leading-relaxed line-clamp-3 mb-6">
              {h.data.descripcion}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
            <span class="text-xs text-amber-400 font-semibold">★ {h.data.rating}</span>
            <a
              href={h.data.urlAfiliado || h.data.urlOficial}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg bg-slate-800 px-3.5 py-1.5 text-xs font-semibold text-slate-200 hover:bg-brand-600 hover:text-white transition-colors"
            >
              Visitar Web ↗
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
