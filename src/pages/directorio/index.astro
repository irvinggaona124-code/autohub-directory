---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const herramientas = await getCollection('herramientas');
const categorias = ['Todas', 'Automatización', 'CRM', 'Marketing', 'E-commerce', 'Open-Source'];
---

<Layout
  title="Directorio Curado de Herramientas de Automatización IA"
  description="Explora las mejores herramientas, motores de automatización y software Open-Source para marketing, ventas y comercio electrónico."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="max-w-3xl mb-8">
      <div class="text-xs font-bold uppercase tracking-wider text-brand-400 mb-2">Ecosistema Completo</div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        Directorio Curado de Herramientas
      </h1>
      <p class="text-base text-slate-400 leading-relaxed">
        Plataformas de automatización, motores de código abierto y herramientas B2B clasificadas para agencias y fundadores que buscan optimizar su presupuesto.
      </p>
    </div>

    <!-- Search & Filter Controls -->
    <div class="mb-10 space-y-4">
      <div class="relative max-w-md">
        <input
          type="text"
          id="searchInput"
          placeholder="Buscar herramienta por nombre o función..."
          class="w-full rounded-xl bg-slate-900 border border-slate-700/80 px-4 py-3 pl-10 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500"
        />
        <span class="absolute left-3.5 top-3.5 text-slate-500 text-sm">🔍</span>
      </div>

      <!-- Filter tabs -->
      <div class="flex flex-wrap gap-2" id="filterTabs">
        {categorias.map((cat, idx) => (
          <button
            type="button"
            data-category={cat}
            class={`category-btn rounded-lg px-3.5 py-1.5 text-xs font-semibold transition-colors ${
              idx === 0
                ? 'bg-brand-600 text-white active-tab'
                : 'bg-slate-900 text-slate-400 border border-slate-800 hover:text-white hover:bg-slate-800'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Tools Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="toolsGrid">
      {herramientas.map((h) => (
        <div
          class="tool-card rounded-2xl border border-slate-800 bg-slate-900/60 p-6 flex flex-col justify-between hover:border-brand-500/40 hover:-translate-y-1 transition-all"
          data-name={h.data.nombre.toLowerCase()}
          data-desc={h.data.descripcion.toLowerCase()}
          data-category={h.data.categoria}
          data-license={h.data.licencia}
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="text-3xl">{h.data.logo || '⚡'}</span>
              <div class="flex items-center gap-1.5">
                <span class="rounded-md bg-slate-800 px-2 py-0.5 text-xs text-slate-300">
                  {h.data.categoria}
                </span>
                <span class={`rounded-md px-2 py-0.5 text-xs font-semibold ${
                  h.data.licencia === 'Open-Source'
                    ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
                    : 'bg-indigo-500/10 text-indigo-400 border border-indigo-500/20'
                }`}>
                  {h.data.licencia}
                </span>
              </div>
            </div>

            <h3 class="text-lg font-bold text-white mb-2">{h.data.nombre}</h3>
            <p class="text-xs text-slate-400 leading-relaxed line-clamp-3 mb-6">
              {h.data.descripcion}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
            <span class="text-xs text-amber-400 font-semibold">★ {h.data.rating}</span>
            <a
              href={h.data.urlAfiliado || h.data.urlOficial}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg bg-slate-800 px-3.5 py-1.5 text-xs font-semibold text-slate-200 hover:bg-brand-600 hover:text-white transition-colors"
            >
              Visitar Web ↗
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Empty State -->
    <div id="noResults" class="hidden text-center py-16">
      <div class="text-4xl mb-3">🔍</div>
      <h3 class="text-lg font-bold text-white mb-1">No se encontraron herramientas</h3>
      <p class="text-xs text-slate-400">Prueba con otra palabra clave o selecciona otra categoría.</p>
    </div>
  </div>

  <!-- Interactive Filter Script -->
  <script is:inline>
    const searchInput = document.getElementById('searchInput');
    const categoryBtns = document.querySelectorAll('.category-btn');
    const cards = document.querySelectorAll('.tool-card');
    const noResults = document.getElementById('noResults');

    let currentCategory = 'Todas';
    let searchQuery = '';

    function filterTools() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const name = card.getAttribute('data-name') || '';
        const desc = card.getAttribute('data-desc') || '';
        const cat = card.getAttribute('data-category') || '';
        const license = card.getAttribute('data-license') || '';

        const matchesSearch = name.includes(searchQuery) || desc.includes(searchQuery);
        let matchesCategory = currentCategory === 'Todas';

        if (currentCategory === 'Open-Source') {
          matchesCategory = license === 'Open-Source';
        } else if (currentCategory !== 'Todas') {
          matchesCategory = cat === currentCategory;
        }

        if (matchesSearch && matchesCategory) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        filterTools();
      });
    }

    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        categoryBtns.forEach((b) => {
          b.classList.remove('bg-brand-600', 'text-white', 'active-tab');
          b.classList.add('bg-slate-900', 'text-slate-400', 'border', 'border-slate-800');
        });

        btn.classList.remove('bg-slate-900', 'text-slate-400', 'border', 'border-slate-800');
        btn.classList.add('bg-brand-600', 'text-white', 'active-tab');

        currentCategory = btn.getAttribute('data-category') || 'Todas';
        filterTools();
      });
    });
  </script>
</Layout>
