---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Publicar tu Herramienta o Plantilla de Automatización"
  description="Presenta tu SaaS de IA, flujo de n8n o herramienta Open-Source ante más de 5,000 operadores de agencias y tiendas online."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 rounded-full bg-brand-500/10 border border-brand-500/20 px-3 py-1 text-xs font-semibold text-brand-300 mb-4">
        <span>🚀 Lanzamientos & Visibilidad B2B</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
        Promociona tu Herramienta de IA ante Compradores Reales
      </h1>
      <p class="text-base text-slate-400 leading-relaxed">
        Llega a operadores de marketing, fundadores de comercio electrónico y desarrolladores de automatizaciones que buscan activamente soluciones para optimizar sus operaciones.
      </p>
    </div>

    <!-- Pricing / Options Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      <!-- Tier 1: Free -->
      <div class="rounded-3xl border border-slate-800 bg-slate-900/40 p-8 flex flex-col justify-between">
        <div>
          <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Estándar</div>
          <div class="text-3xl font-extrabold text-white mb-1">0 USD</div>
          <div class="text-xs text-slate-500 mb-6">Revisión manual sin costo</div>

          <ul class="space-y-3 text-xs text-slate-300 mb-8">
            <li class="flex items-center gap-2">
              <span class="text-slate-500">•</span> Ficha básica en el directorio
            </li>
            <li class="flex items-center gap-2">
              <span class="text-slate-500">•</span> Enlace nofollow
            </li>
            <li class="flex items-center gap-2 text-slate-500">
              <span>⏱️</span> Cola de espera: 30 a 45 días
            </li>
          </ul>
        </div>

        <a
          href="#formulario"
          class="w-full block text-center rounded-xl bg-slate-800 py-3 text-xs font-bold text-slate-300 hover:bg-slate-700 hover:text-white transition-colors"
        >
          Enviar Gratis
        </a>
      </div>

      <!-- Tier 2: Fast-Track (Recommended) -->
      <div class="relative rounded-3xl border border-brand-500/60 bg-gradient-to-b from-brand-950/50 to-slate-900/90 p-8 flex flex-col justify-between shadow-2xl shadow-brand-500/15">
        <div class="absolute -top-3.5 right-6 rounded-full bg-gradient-to-r from-brand-500 to-indigo-500 px-3.5 py-1 text-[11px] font-extrabold text-white shadow-md">
          Más Popular
        </div>

        <div>
          <div class="text-xs font-bold text-brand-400 uppercase tracking-wider mb-2">Fast-Track Pass</div>
          <div class="text-3xl font-extrabold text-white mb-1">25 USD</div>
          <div class="text-xs text-slate-400 mb-6">Pago único • Sin mensualidades</div>

          <ul class="space-y-3 text-xs text-slate-200 mb-8">
            <li class="flex items-center gap-2 font-medium">
              <span class="text-emerald-400 font-bold">✓</span> <strong>Revisión prioritaria en 48 horas</strong>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold">✓</span> <strong>Enlace dofollow permanente</strong>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold">✓</span> Indexación rápida en sitemap pSEO
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold">✓</span> Insignia de herramienta verificada
            </li>
          </ul>
        </div>

        <a
          href="https://payhip.com/b/demo-fast-track"
          class="payhip-buy-button w-full block text-center rounded-xl bg-gradient-to-r from-brand-600 to-indigo-600 py-3.5 text-xs font-bold text-white hover:from-brand-500 hover:to-indigo-500 shadow-lg shadow-brand-600/30 transition-all hover:scale-[1.02]"
        >
          Comprar Fast-Track (25 USD)
        </a>
      </div>

      <!-- Tier 3: Featured Sponsor -->
      <div id="patrocinio" class="rounded-3xl border border-slate-800 bg-slate-900/40 p-8 flex flex-col justify-between">
        <div>
          <div class="text-xs font-bold text-indigo-400 uppercase tracking-wider mb-2">Patrocinio Mensual</div>
          <div class="text-3xl font-extrabold text-white mb-1">99 USD<span class="text-xs text-slate-500 font-normal"> / mes</span></div>
          <div class="text-xs text-slate-500 mb-6">Máxima exposición garantizada</div>

          <ul class="space-y-3 text-xs text-slate-300 mb-8">
            <li class="flex items-center gap-2">
              <span class="text-brand-400 font-bold">✓</span> Todo lo de Fast-Track incluido
            </li>
            <li class="flex items-center gap-2">
              <span class="text-brand-400 font-bold">✓</span> Banner destacado en la portada
            </li>
            <li class="flex items-center gap-2">
              <span class="text-brand-400 font-bold">✓</span> Mención en 1 edición del boletín
            </li>
            <li class="flex items-center gap-2">
              <span class="text-brand-400 font-bold">✓</span> Reporte mensual de clics
            </li>
          </ul>
        </div>

        <a
          href="https://payhip.com/b/demo-sponsor"
          class="payhip-buy-button w-full block text-center rounded-xl bg-slate-800 py-3 text-xs font-bold text-slate-300 hover:bg-slate-700 hover:text-white transition-colors"
        >
          Patrocinar por 99 USD/mes
        </a>
      </div>
    </div>

    <!-- Free Submission Form -->
    <div id="formulario" class="max-w-xl mx-auto rounded-3xl border border-slate-800 bg-slate-900/60 p-8 sm:p-10">
      <h3 class="text-xl font-bold text-white mb-2">Formulario de Envío</h3>
      <p class="text-xs text-slate-400 mb-6">
        Completa los datos de tu herramienta o flujo de trabajo para entrar en la cola de revisión.
      </p>

      <form class="space-y-4" onsubmit="event.preventDefault(); alert('¡Herramienta enviada a revisión con éxito!');">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Nombre de la Herramienta o Plantilla *</label>
          <input
            type="text"
            required
            placeholder="Ej: AutoScraper Pro"
            class="w-full rounded-xl bg-slate-950 border border-slate-800 px-4 py-2.5 text-sm text-white focus:outline-none focus:border-brand-500"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">URL de la Página Web o Repositorio *</label>
          <input
            type="url"
            required
            placeholder="https://ejemplo.com"
            class="w-full rounded-xl bg-slate-950 border border-slate-800 px-4 py-2.5 text-sm text-white focus:outline-none focus:border-brand-500"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Categoría Principal *</label>
          <select class="w-full rounded-xl bg-slate-950 border border-slate-800 px-4 py-2.5 text-sm text-white focus:outline-none focus:border-brand-500">
            <option>Automatización (n8n / Make)</option>
            <option>Marketing & Redes Sociales</option>
            <option>E-commerce & Shopify</option>
            <option>Prospección B2B & Scraping</option>
            <option>Alternativa Open-Source</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Descripción Breve (Dolor que resuelve) *</label>
          <textarea
            rows="3"
            required
            placeholder="Explica qué hace tu herramienta y cuánto tiempo o dinero ahorra..."
            class="w-full rounded-xl bg-slate-950 border border-slate-800 px-4 py-2.5 text-sm text-white focus:outline-none focus:border-brand-500"
          ></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Tu Correo Electrónico (Para notificarte) *</label>
          <input
            type="email"
            required
            placeholder="tu@correo.com"
            class="w-full rounded-xl bg-slate-950 border border-slate-800 px-4 py-2.5 text-sm text-white focus:outline-none focus:border-brand-500"
          />
        </div>

        <button
          type="submit"
          class="w-full rounded-xl bg-brand-600 py-3 text-sm font-bold text-white hover:bg-brand-500 shadow-md shadow-brand-600/25 transition-all mt-4"
        >
          Enviar a Revisión Gratuita
        </button>
      </form>
    </div>
  </div>
</Layout>
