---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const plantillas = await getCollection('plantillas');
  return plantillas.map((plantilla) => ({
    params: { slug: plantilla.slug },
    props: { plantilla },
  }));
}

const { plantilla } = Astro.props;
const { Content } = await plantilla.render();

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: plantilla.data.titulo,
  description: plantilla.data.descripcionCorta,
  offers: {
    '@type': 'Offer',
    price: plantilla.data.precio,
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: plantilla.data.payhipUrl,
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: '34',
  },
};

// Map slug to public workflow json
const jsonWorkflowMap: Record<string, string> = {
  'bot-whatsapp-catalogo-pdf-n8n-openai': '/workflows/bot-whatsapp-catalogo-pdf.json',
  'google-maps-lead-scraper-firecrawl-n8n': '/workflows/google-maps-lead-scraper.json',
  'youtube-transcription-multi-social-repurpose': '/workflows/youtube-transcription-multi-social.json',
};
const workflowJsonPath = jsonWorkflowMap[plantilla.slug];
---

<Layout
  title={plantilla.data.titulo}
  description={plantilla.data.descripcionCorta}
  schema={productSchema}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-8">
      <a href="/" class="hover:text-white transition-colors">Inicio</a>
      <span>/</span>
      <a href="/plantillas" class="hover:text-white transition-colors">Plantillas</a>
      <span>/</span>
      <span class="text-slate-300 truncate max-w-xs">{plantilla.data.titulo}</span>
    </nav>

    <!-- Header Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start mb-12">
      <div class="lg:col-span-2">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="rounded-md bg-brand-500/10 border border-brand-500/20 px-3 py-1 text-xs font-semibold text-brand-400">
            {plantilla.data.motor}
          </span>
          <span class="rounded-md bg-slate-800 px-3 py-1 text-xs font-medium text-slate-300">
            {plantilla.data.categoria}
          </span>
          <span class="rounded-md bg-indigo-500/10 px-3 py-1 text-xs font-semibold text-indigo-400">
            ⚙️ {plantilla.data.nodos} nodos incluidos
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight mb-4">
          {plantilla.data.titulo}
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed mb-6">
          {plantilla.data.descripcionCorta}
        </p>

        <!-- Value highlight box -->
        <div class="rounded-2xl bg-emerald-500/10 border border-emerald-500/20 p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <span class="text-2xl">💰</span>
            <div>
              <div class="text-sm font-bold text-emerald-400">Ahorro laboral mensual estimado</div>
              <div class="text-xs text-slate-400">Basado en ~20 horas de trabajo manual ahorradas al mes</div>
            </div>
          </div>
          <span class="text-lg font-extrabold text-emerald-300 shrink-0">{plantilla.data.ahorroLaboralMensual}</span>
        </div>
      </div>

      <!-- Purchase Box Desktop Sidebar -->
      <div class="rounded-3xl border border-slate-800 bg-slate-900/80 p-6 shadow-xl sticky top-24">
        <div class="flex items-baseline justify-between mb-2">
          <span class="text-3xl font-extrabold text-white">{plantilla.data.precio} USD</span>
          {plantilla.data.precioOriginal && (
            <span class="text-sm text-slate-500 line-through">{plantilla.data.precioOriginal} USD</span>
          )}
        </div>
        <p class="text-xs text-slate-400 mb-6">
          Pago único sin comisiones mensuales ocultas. Archivo JSON descargable listo para importar.
        </p>

        <a
          href={plantilla.data.payhipUrl}
          class="payhip-buy-button w-full block text-center rounded-xl bg-gradient-to-r from-brand-600 to-indigo-600 py-3.5 text-sm font-bold text-white hover:from-brand-500 hover:to-indigo-500 shadow-lg shadow-brand-600/30 transition-all hover:scale-[1.02] mb-3"
        >
          Descargar Plantilla Completa
        </a>

        {workflowJsonPath && (
          <a
            href={workflowJsonPath}
            download
            class="w-full block text-center rounded-xl bg-slate-800 py-2.5 text-xs font-semibold text-slate-300 hover:bg-slate-700 hover:text-white transition-colors mb-3"
          >
            Descargar Muestra Demo (.json)
          </a>
        )}

        {plantilla.data.gumroadUrl && (
          <a
            href={plantilla.data.gumroadUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full block text-center rounded-xl border border-slate-700/60 py-2 text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
          >
            Comprar en Gumroad Discover
          </a>
        )}

        <div class="mt-6 pt-6 border-t border-slate-800 space-y-2 text-xs text-slate-400">
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">✓</span> Entrega digital instantánea
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">✓</span> Archivo JSON compatible con n8n Cloud y Self-hosted
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">✓</span> Mapeo de variables y video guía incluido
          </div>
        </div>
      </div>
    </div>

    <!-- Requirements & Features -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-12 pt-12 border-t border-slate-800">
      <div class="rounded-2xl border border-slate-800/80 bg-slate-900/40 p-6">
        <h3 class="text-base font-bold text-white mb-4 flex items-center gap-2">
          <span>📋</span> Requisitos Previos
        </h3>
        <ul class="space-y-2 text-sm text-slate-300">
          {plantilla.data.requisitos.map((req) => (
            <li class="flex items-start gap-2">
              <span class="text-slate-500">•</span>
              <span>{req}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl border border-slate-800/80 bg-slate-900/40 p-6">
        <h3 class="text-base font-bold text-white mb-4 flex items-center gap-2">
          <span>⚡</span> Funciones Incluidas
        </h3>
        <ul class="space-y-2 text-sm text-slate-300">
          {plantilla.data.caracteristicas.map((car) => (
            <li class="flex items-start gap-2">
              <span class="text-brand-400 font-bold">✓</span>
              <span>{car}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Long form content / Guide -->
    <div class="prose prose-invert prose-indigo max-w-none pt-8 border-t border-slate-800">
      <Content />
    </div>
  </div>
</Layout>
