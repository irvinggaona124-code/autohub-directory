---
import Layout from '../../layouts/Layout.astro';
import TalentCard from '../../components/TalentCard.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const talentoList = await getCollection('talento');
---

<Layout
  title="Directorio de Talento Joven Anonimizado · Umbral Panamá"
  description="Conoce perfiles estudiantiles de Panamá evaluados por potencial, rigor académico e inglés verificado. Privacidad absoluta y contacto con consentimiento."
>
  <main class="min-h-screen pb-20">
    <!-- Intro Banner (Figma: Talent intro) -->
    <section class="border-b border-sand-400 bg-sand-200/40 py-12 sm:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
          <div>
            <span class="inline-block text-xs font-bold tracking-widest text-terracotta-500 uppercase mb-3">
              DIRECTORIO DEMOSTRATIVO
            </span>
            <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl text-forest-900 font-normal tracking-tight mb-3">
              Conoce el talento más allá del CV.
            </h1>
            <p class="text-sm sm:text-base text-sage-700 max-w-2xl leading-relaxed">
              Perfiles de ejemplo con señales académicas, intereses e inglés verificable.
            </p>
          </div>

          <!-- Privacy Callout Pill (Figma #6:615) -->
          <div class="bg-sand-50 border border-sand-400 rounded-xl px-4 py-3 flex items-center gap-3 shadow-sm lg:max-w-xs shrink-0">
            <span class="w-2.5 h-2.5 rounded-full bg-forest-900 shrink-0 animate-pulse"></span>
            <span class="text-xs font-medium text-forest-900 leading-tight">
              Los datos de contacto permanecen ocultos hasta autorizar la solicitud.
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Talent Grid Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10">
      
      <!-- Filter and Count Strip -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
        <div>
          <h2 class="text-xs font-bold uppercase tracking-wider text-sage-700">
            {talentoList.length} perfiles de ejemplo · Anonimizados
          </h2>
          <p class="text-xs text-sage-600 mt-0.5">
            Filtrar por universidad o señal clave de potencial
          </p>
        </div>

        <!-- Filter Pills -->
        <div class="flex flex-wrap items-center gap-2" id="filter-container">
          <button
            type="button"
            class="filter-btn px-3 py-1.5 rounded-pill text-xs font-bold bg-forest-900 text-white border border-forest-900 transition-all"
            data-filter="all"
          >
            Todos
          </button>
          <button
            type="button"
            class="filter-btn px-3 py-1.5 rounded-pill text-xs font-medium bg-sand-100 text-forest-900 border border-sand-400 hover:border-forest-900 transition-all"
            data-filter="UTP"
          >
            UTP
          </button>
          <button
            type="button"
            class="filter-btn px-3 py-1.5 rounded-pill text-xs font-medium bg-sand-100 text-forest-900 border border-sand-400 hover:border-forest-900 transition-all"
            data-filter="UP"
          >
            UP
          </button>
          <button
            type="button"
            class="filter-btn px-3 py-1.5 rounded-pill text-xs font-medium bg-sand-100 text-forest-900 border border-sand-400 hover:border-forest-900 transition-all"
            data-filter="USMA"
          >
            USMA
          </button>
          <button
            type="button"
            class="filter-btn px-3 py-1.5 rounded-pill text-xs font-medium bg-sand-100 text-forest-900 border border-sand-400 hover:border-forest-900 transition-all"
            data-filter="UIP"
          >
            UIP
          </button>
          <button
            type="button"
            class="filter-btn px-3 py-1.5 rounded-pill text-xs font-medium bg-sand-100 text-forest-900 border border-sand-400 hover:border-forest-900 transition-all"
            data-filter="UDELAS"
          >
            UDELAS
          </button>
        </div>
      </div>

      <!-- Grid of Cards (Figma: Talent profiles grid) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="talent-grid">
        {talentoList.map((talento) => (
          <div class="talent-item" data-uni={talento.data.universidad} data-ingles={talento.data.ingles}>
            <TalentCard
              codigo={talento.data.codigo}
              carrera={talento.data.carrera}
              universidad={talento.data.universidad}
              etapa={talento.data.etapa}
              ubicacion={talento.data.ubicacion}
              indice={talento.data.indice}
              ingles={talento.data.ingles}
              afinidad={talento.data.afinidad}
              perfilCompletado={talento.data.perfilCompletado}
            />
          </div>
        ))}
      </div>

      <!-- Anonymity Callout (Figma #6:730) -->
      <div class="mt-12 bg-sand-200/60 border border-sand-400 rounded-2xl p-5 sm:p-6 flex items-start sm:items-center gap-3.5 shadow-sm">
        <span class="w-6 h-6 rounded-full bg-forest-900 text-white flex items-center justify-center font-bold text-xs shrink-0">
          ✓
        </span>
        <p class="text-xs sm:text-sm text-forest-900 leading-relaxed">
          <strong>Perfiles demostrativos anonimizados:</strong> En una versión en producción, los estudiantes nunca reciben llamadas frías ni spam; solo se comparte información de contacto cuando el estudiante aprueba formalmente la oportunidad propuesta por la empresa.
        </p>
      </div>

      <!-- Action callout for students -->
      <div class="mt-8 text-center bg-sand-50 border border-sand-400 rounded-2xl p-8 max-w-2xl mx-auto shadow-sm">
        <h3 class="font-serif text-2xl text-forest-900 mb-2">
          ¿Eres estudiante universitario en Panamá?
        </h3>
        <p class="text-xs text-sage-700 mb-5 leading-relaxed">
          Crea tu propio perfil de potencial sin necesidad de tener experiencia previa en menos de 3 minutos.
        </p>
        <a
          href={`${base}/estudiantes`}
          class="inline-flex items-center justify-center px-6 py-2.5 text-xs font-bold rounded-pill bg-terracotta-500 text-white hover:bg-terracotta-600 shadow-sm transition-all"
        >
          Crear mi perfil gratis
        </a>
      </div>
    </section>

    <!-- Modal for Solicitar Contacto -->
    <div
      id="contact-modal"
      class="fixed inset-0 z-50 bg-forest-950/40 backdrop-blur-sm hidden flex items-center justify-center p-4"
      onclick="if(event.target === this) window.closeContactModal();"
    >
      <div class="bg-sand-50 border border-sand-400 rounded-2xl max-w-md w-full p-6 shadow-xl relative animate-in fade-in zoom-in-95 duration-200">
        <div class="flex items-center justify-between border-b border-sand-400 pb-3 mb-4">
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-terracotta-500 block">
              Solicitud de Contacto Ético
            </span>
            <h3 class="font-serif text-lg text-forest-900 font-bold" id="modal-candidate-title">
              Candidato UTP-402
            </h3>
          </div>
          <button
            onclick="window.closeContactModal()"
            class="text-sage-600 hover:text-forest-900 text-lg font-bold p-1 leading-none"
          >
            ✕
          </button>
        </div>

        <form onsubmit="event.preventDefault(); window.submitContactRequest();" class="space-y-4">
          <p class="text-xs text-sage-700 leading-relaxed">
            Tu empresa enviará una invitación a la bandeja del estudiante. Si el estudiante encuentra la oportunidad atractiva, ambos recibirán sus datos de contacto directo.
          </p>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-forest-900 mb-1.5">
              Nombre de tu empresa
            </label>
            <input
              type="text"
              id="modal-emp-name"
              placeholder="Ej. Faro Consultores"
              required
              class="w-full bg-sand-100 border border-sand-400 rounded-pill px-4 py-2 text-xs text-forest-900 focus:outline-none focus:ring-2 focus:ring-forest-900"
            />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-forest-900 mb-1.5">
              Título de la oportunidad ofrecida
            </label>
            <input
              type="text"
              id="modal-opp-title"
              placeholder="Ej. Pasantía en Análisis Financiero"
              required
              class="w-full bg-sand-100 border border-sand-400 rounded-pill px-4 py-2 text-xs text-forest-900 focus:outline-none focus:ring-2 focus:ring-forest-900"
            />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-forest-900 mb-1.5">
              Asignación económica ofrecida (B/.)
            </label>
            <input
              type="text"
              id="modal-opp-stipend"
              value="B/. 450 al mes"
              required
              class="w-full bg-sand-100 border border-sand-400 rounded-pill px-4 py-2 text-xs text-forest-900 focus:outline-none focus:ring-2 focus:ring-forest-900"
            />
          </div>

          <div class="pt-2 flex items-center justify-end gap-2 border-t border-sand-400">
            <button
              type="button"
              onclick="window.closeContactModal()"
              class="px-4 py-2 text-xs font-semibold rounded-pill bg-sand-200 text-forest-900 hover:bg-sand-300"
            >
              Cancelar
            </button>
            <button
              type="submit"
              class="px-5 py-2 text-xs font-bold rounded-pill bg-forest-900 text-white hover:bg-forest-800"
            >
              Enviar invitación
            </button>
          </div>
        </form>

        <div id="modal-success" class="hidden text-center py-6 space-y-3">
          <div class="w-12 h-12 rounded-full bg-forest-900 text-white flex items-center justify-center mx-auto text-xl font-bold">
            ✓
          </div>
          <h4 class="font-serif text-lg text-forest-900">¡Invitación enviada con éxito!</h4>
          <p class="text-xs text-sage-700">
            El perfil ha sido notificado de tu interés respetando su soberanía de datos.
          </p>
          <button
            onclick="window.closeContactModal()"
            class="px-5 py-2 text-xs font-bold rounded-pill bg-sand-200 text-forest-900 hover:bg-sand-300 mt-2"
          >
            Cerrar
          </button>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  // Filter pills logic
  const filterBtns = document.querySelectorAll('.filter-btn');
  const items = document.querySelectorAll('.talent-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('bg-forest-900', 'text-white', 'border-forest-900', 'font-bold');
        b.classList.add('bg-sand-100', 'text-forest-900', 'border-sand-400', 'font-medium');
      });

      btn.classList.remove('bg-sand-100', 'text-forest-900', 'border-sand-400', 'font-medium');
      btn.classList.add('bg-forest-900', 'text-white', 'border-forest-900', 'font-bold');

      const filter = btn.getAttribute('data-filter');

      items.forEach((item) => {
        const uni = item.getAttribute('data-uni');
        if (filter === 'all' || (uni && uni.toUpperCase().includes(filter.toUpperCase()))) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    });
  });

  // Contact Modal Logic
  window.openContactModal = function(codigo, carrera, uni) {
    const modal = document.getElementById('contact-modal');
    const title = document.getElementById('modal-candidate-title');
    if (title) title.textContent = `${codigo} · ${carrera} (${uni})`;
    if (modal) {
      modal.classList.remove('hidden');
      document.querySelector('#contact-modal form')?.classList.remove('hidden');
      document.getElementById('modal-success')?.classList.add('hidden');
    }
  };

  window.closeContactModal = function() {
    const modal = document.getElementById('contact-modal');
    if (modal) modal.classList.add('hidden');
  };

  window.submitContactRequest = function() {
    document.querySelector('#contact-modal form')?.classList.add('hidden');
    document.getElementById('modal-success')?.classList.remove('hidden');
  };
</script>
