---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const alternativas = await getCollection('alternativas');
  return alternativas.map((alt) => ({
    params: { slug: alt.slug },
    props: { alt },
  }));
}

const { alt } = Astro.props;
const { Content } = await alt.render();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: alt.data.titulo,
  description: `Comparativa detallada entre ${alt.data.saasPropietario} y ${alt.data.alternativaOpenSource}. Ahorro estimado de ${alt.data.ahorroEstimadoMensual}.`,
  author: {
    '@type': 'Organization',
    name: 'AutoHub Editorial',
  },
};
---

<Layout
  title={alt.data.titulo}
  description={`Comparativa entre ${alt.data.saasPropietario} y ${alt.data.alternativaOpenSource}. Ahorro de ${alt.data.ahorroEstimadoMensual}.`}
  schema={articleSchema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-8">
      <a href="/" class="hover:text-white transition-colors">Inicio</a>
      <span>/</span>
      <a href="/alternativas" class="hover:text-white transition-colors">Alternativas</a>
      <span>/</span>
      <span class="text-slate-300 truncate max-w-xs">{alt.data.titulo}</span>
    </nav>

    <!-- Header -->
    <div class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="rounded-md bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 text-xs font-semibold text-emerald-400">
          Open-Source
        </span>
        <span class="rounded-md bg-slate-800 px-3 py-1 text-xs font-medium text-slate-300">
          {alt.data.categoria}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight mb-4">
        {alt.data.titulo}
      </h1>

      <!-- Comparison visual cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-8">
        <div class="rounded-2xl border border-rose-500/30 bg-rose-950/20 p-6">
          <div class="text-xs font-bold text-rose-400 uppercase tracking-wider mb-1">Software Propietario Caro</div>
          <div class="text-xl font-extrabold text-white mb-2">{alt.data.saasPropietario}</div>
          <div class="text-xs text-slate-400">Planes con límites de usuarios, sobrecostes y aumentos periódicos de precio.</div>
        </div>

        <div class="rounded-2xl border border-emerald-500/30 bg-emerald-950/20 p-6">
          <div class="text-xs font-bold text-emerald-400 uppercase tracking-wider mb-1">Alternativa Open-Source</div>
          <div class="text-xl font-extrabold text-white mb-2">{alt.data.alternativaOpenSource}</div>
          <div class="text-xs text-slate-300">Código libre en GitHub, autohospedable y sin límites de asientos.</div>
        </div>
      </div>

      <!-- Savings & CTA -->
      <div class="rounded-2xl bg-gradient-to-r from-emerald-950/60 to-slate-900 border border-emerald-500/30 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <div class="text-xs font-bold text-emerald-400 uppercase">Impacto Financiero</div>
          <div class="text-lg font-bold text-white">Ahorro estimado: {alt.data.ahorroEstimadoMensual}</div>
        </div>

        {alt.data.enlaceAfiliado && (
          <a
            href={alt.data.enlaceAfiliado}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-xl bg-emerald-600 px-5 py-3 text-xs font-bold text-white hover:bg-emerald-500 shadow-lg shadow-emerald-600/25 transition-all hover:scale-105 shrink-0"
          >
            {alt.data.ctaTexto} →
          </a>
        )}
      </div>
    </div>

    <!-- Advantages vs Limitations -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-10">
      <div class="rounded-2xl border border-slate-800 bg-slate-900/40 p-6">
        <h3 class="text-sm font-bold text-emerald-400 uppercase tracking-wider mb-3">Ventajas de la Alternativa</h3>
        <ul class="space-y-2 text-sm text-slate-300">
          {alt.data.ventajasOpenSource.map((v) => (
            <li class="flex items-start gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>{v}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl border border-slate-800 bg-slate-900/40 p-6">
        <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider mb-3">Limitaciones a Considerar</h3>
        <ul class="space-y-2 text-sm text-slate-300">
          {alt.data.limitaciones.map((l) => (
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-bold">!</span>
              <span>{l}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Article Content -->
    <div class="prose prose-invert prose-indigo max-w-none pt-8 border-t border-slate-800">
      <Content />
    </div>
  </div>
</Layout>
