---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const faqs = [
  {
    q: '¿Tengo que tener experiencia previa?',
    a: 'No. Todas las oportunidades en Umbral están diseñadas estrictamente para comenzar desde cero. Ninguna vacante puede exigir años previos de experiencia.',
  },
  {
    q: '¿Debo subir una hoja de vida en PDF?',
    a: 'No es requisito. El portal te permite construir un perfil de potencial basado en tus estudios actuales, tus intereses vocacionales y proyectos de clase.',
  },
  {
    q: '¿Las oportunidades y perfiles son reales?',
    a: 'No. Esta versión es una demostración interactiva de alta fidelidad para presentar un nuevo estándar de inserción laboral juvenil en la República de Panamá.',
  },
  {
    q: '¿Cómo se define el estipendio económico?',
    a: 'Las empresas formadoras deben fijar asignaciones transparentes en Balboas (B/.) para cubrir gastos de movilización y manutención, evitando esquemas no remunerados.',
  },
  {
    q: '¿Cómo protege Umbral la privacidad del estudiante?',
    a: 'Toda la exhibición en el directorio es anonimizada (ej. UTP-402). La información de contacto personal solo se comparte tras una doble confirmación voluntaria.',
  },
  {
    q: '¿Qué instituciones académicas participan?',
    a: 'El formato está adaptado para estudiantes de universidades oficiales y particulares de Panamá (UTP, UP, USMA, UIP, UDELAS, entre otras), así como institutos técnicos superiores.',
  },
];
---

<Layout
  title="Guía de Rutas Formativas y Privacidad · Umbral Panamá"
  description="Conoce las 3 rutas de entrada profesional en Panamá: pasantías formativas, prácticas de graduación y primer empleo. Transparencia y privacidad de datos."
>
  <main class="min-h-screen pb-20">
    <!-- Intro Banner (Figma: Guide intro) -->
    <section class="border-b border-sand-400 bg-sand-200/40 py-12 sm:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <span class="inline-block text-xs font-bold tracking-widest text-terracotta-500 uppercase mb-3">
          GUÍA · RUTAS Y PRIVACIDAD
        </span>
        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl text-forest-900 font-normal tracking-tight mb-4 max-w-3xl">
          Todo empieza con una conversación clara.
        </h1>
        <p class="text-sm sm:text-base text-sage-700 max-w-2xl leading-relaxed">
          Orientación para estudiantes y empresas. Verifica requisitos con la institución y el programa correspondiente.
        </p>
      </div>
    </section>

    <!-- Section 1: The 3 Routes (Figma: Section heading & Guide routes) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-16">
      <div class="mb-8">
        <span class="text-xs font-bold uppercase tracking-wider text-terracotta-500 block mb-1">
          PARA ESTUDIANTES
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl text-forest-900 font-normal">
          Tres rutas, una decisión informada.
        </h2>
        <p class="text-xs text-sage-700 mt-1">
          Las condiciones académicas y laborales dependen del programa seleccionado.
        </p>
      </div>

      <!-- 3 Route Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Route 1: Pasantía formativa -->
        <div class="bg-sand-50 border border-sand-400 rounded-2xl p-6 sm:p-7 flex flex-col justify-between hover:border-forest-900/40 hover:shadow-md transition-all">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs font-bold text-terracotta-500 bg-terracotta-100/70 px-2.5 py-1 rounded-pill">
                RUTA 01
              </span>
              <span class="text-xs font-semibold text-sage-600">2 a 6 meses</span>
            </div>
            <h3 class="font-serif text-xl font-bold text-forest-900 mb-2">
              Pasantía formativa
            </h3>
            <p class="text-xs text-sage-700 leading-relaxed mb-6">
              Aprendizaje guiado dentro de una empresa. Diseñada para adquirir primeras competencias en un entorno laboral real con horario compatible con tus estudios.
            </p>

            <ul class="space-y-2 text-xs text-forest-900 border-t border-sand-400/80 pt-4">
              <li class="flex items-center gap-2">
                <span class="text-terracotta-500 font-bold">✓</span>
                <span>Mentoría con profesional sénior</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-terracotta-500 font-bold">✓</span>
                <span>Estipendio sugerido: B/. 300 - B/. 500</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-terracotta-500 font-bold">✓</span>
                <span>Modalidad híbrida o flexible</span>
              </li>
            </ul>
          </div>

          <div class="pt-6 mt-6 border-t border-sand-400/80">
            <a
              href={`${base}/vacantes?ruta=Pasant%C3%ADa+formativa`}
              class="w-full inline-flex items-center justify-center py-2 px-4 rounded-pill text-xs font-bold bg-sand-200 text-forest-900 hover:bg-forest-900 hover:text-white transition-all"
            >
              Ver vacantes de pasantía →
            </a>
          </div>
        </div>

        <!-- Route 2: Práctica profesional -->
        <div class="bg-sand-50 border border-forest-900/40 rounded-2xl p-6 sm:p-7 flex flex-col justify-between shadow-sm hover:shadow-md transition-all">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs font-bold text-forest-900 bg-sand-200 px-2.5 py-1 rounded-pill">
                RUTA 02
              </span>
              <span class="text-xs font-semibold text-sage-600">Horas de grado</span>
            </div>
            <h3 class="font-serif text-xl font-bold text-forest-900 mb-2">
              Práctica profesional
            </h3>
            <p class="text-xs text-sage-700 leading-relaxed mb-6">
              Experiencia supervisada ligada a graduación. Cumple formalmente con los requisitos curriculares de tu universidad (UTP, UP, USMA, etc.).
            </p>

            <ul class="space-y-2 text-xs text-forest-900 border-t border-sand-400/80 pt-4">
              <li class="flex items-center gap-2">
                <span class="text-forest-900 font-bold">✓</span>
                <span>Convenio con la facultad universitaria</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-forest-900 font-bold">✓</span>
                <span>Evaluación conjunta con tutor académico</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-forest-900 font-bold">✓</span>
                <span>Certificación de horas de práctica</span>
              </li>
            </ul>
          </div>

          <div class="pt-6 mt-6 border-t border-sand-400/80">
            <a
              href={`${base}/vacantes?ruta=Pr%C3%A1ctica+profesional`}
              class="w-full inline-flex items-center justify-center py-2 px-4 rounded-pill text-xs font-bold bg-forest-900 text-white hover:bg-forest-800 transition-all"
            >
              Ver vacantes de práctica →
            </a>
          </div>
        </div>

        <!-- Route 3: Primer empleo -->
        <div class="bg-sand-50 border border-sand-400 rounded-2xl p-6 sm:p-7 flex flex-col justify-between hover:border-forest-900/40 hover:shadow-md transition-all">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs font-bold text-terracotta-500 bg-terracotta-100/70 px-2.5 py-1 rounded-pill">
                RUTA 03
              </span>
              <span class="text-xs font-semibold text-sage-600">Primer contrato</span>
            </div>
            <h3 class="font-serif text-xl font-bold text-forest-900 mb-2">
              Primer empleo
            </h3>
            <p class="text-xs text-sage-700 leading-relaxed mb-6">
              Entrada profesional con acompañamiento estructurado. Diseñada para recién graduados o estudiantes en fase de tesis con mentoría intensiva durante los primeros 90 días.
            </p>

            <ul class="space-y-2 text-xs text-forest-900 border-t border-sand-400/80 pt-4">
              <li class="flex items-center gap-2">
                <span class="text-terracotta-500 font-bold">✓</span>
                <span>Contrato formal de trabajo en Panamá</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-terracotta-500 font-bold">✓</span>
                <span>Plan de desarrollo y crecimiento anual</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-terracotta-500 font-bold">✓</span>
                <span>Remuneración competitiva de entrada</span>
              </li>
            </ul>
          </div>

          <div class="pt-6 mt-6 border-t border-sand-400/80">
            <a
              href={`${base}/vacantes?ruta=Primer+empleo`}
              class="w-full inline-flex items-center justify-center py-2 px-4 rounded-pill text-xs font-bold bg-sand-200 text-forest-900 hover:bg-forest-900 hover:text-white transition-all"
            >
              Ver vacantes de primer empleo →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Privacy Panel (Figma: Privacy panel) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
      <div class="bg-forest-900 text-sand-50 rounded-2xl p-8 sm:p-10 shadow-lg">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-5">
            <span class="text-xs font-bold uppercase tracking-wider text-sand-300 block mb-2">
              SOBERANÍA DE DATOS
            </span>
            <h2 class="font-serif text-3xl sm:text-4xl text-white font-normal leading-tight">
              Tus datos, tus decisiones.
            </h2>
          </div>
          <div class="lg:col-span-7 space-y-3 text-xs sm:text-sm text-sand-200 leading-relaxed">
            <p>
              La demo de Umbral no envía ni guarda información en servidores externos. En una implementación productiva, todo servicio formativo debe cumplir de manera rigurosa con la <strong>Ley 81 de Protección de Datos Personales de la República de Panamá</strong>.
            </p>
            <p class="text-xs text-sand-300/80">
              Garantizamos consentimiento previo, perfiles anonimizados para evitar sesgos inconscientes y mecanismos inmediatos para solicitar la revocación o eliminación definitiva de datos.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: FAQ Accordion (Figma: FAQ heading & FAQ list) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-12" id="faq">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left Heading -->
        <div class="lg:col-span-4">
          <span class="text-xs font-bold uppercase tracking-wider text-terracotta-500 block mb-1">
            DUDAS FRECUENTES
          </span>
          <h2 class="font-serif text-3xl text-forest-900 font-normal leading-tight mb-3">
            Antes de dar el paso.
          </h2>
          <p class="text-xs text-sage-700 leading-relaxed mb-6">
            Respuestas directas a las preguntas que se hacen a menudo estudiantes universitarios y empresas empleadoras en Panamá.
          </p>

          <a
            href={`${base}/estudiantes`}
            class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-bold rounded-pill bg-terracotta-500 text-white hover:bg-terracotta-600 transition-all shadow-sm"
          >
            Crear perfil de potencial
          </a>
        </div>

        <!-- Right Accordion List -->
        <div class="lg:col-span-8 space-y-3">
          {faqs.map((faq, index) => (
            <details class="group bg-sand-50 border border-sand-400 rounded-xl p-4 sm:p-5 transition-all open:shadow-sm">
              <summary class="flex items-center justify-between cursor-pointer font-medium text-forest-900 text-xs sm:text-sm list-none font-sans">
                <span class="font-bold pr-4">{faq.q}</span>
                <span class="w-6 h-6 rounded-full bg-sand-200 flex items-center justify-center text-forest-900 text-xs font-bold shrink-0 group-open:rotate-180 transition-transform duration-200">
                  ↓
                </span>
              </summary>
              <div class="pt-3 mt-3 border-t border-sand-400/60 text-xs text-sage-700 leading-relaxed">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
