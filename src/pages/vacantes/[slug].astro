---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const vacantes = await getCollection('vacantes');
  return vacantes.map((v) => ({
    params: { slug: v.slug },
    props: { vacante: v },
  }));
}

const { vacante } = Astro.props;
const { Content } = await vacante.render();

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const jobSchema = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: vacante.data.titulo,
  description: vacante.data.descripcion,
  hiringOrganization: {
    '@type': 'Organization',
    name: vacante.data.empresa,
  },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: vacante.data.ubicacion,
      addressCountry: 'PA',
    },
  },
  baseSalary: {
    '@type': 'MonetaryAmount',
    currency: 'PAB',
    value: {
      '@type': 'QuantitativeValue',
      value: vacante.data.estipendio,
      unitText: 'MONTH',
    },
  },
  employmentType: 'INTERN',
  experienceRequirements: 'No experience required',
};
---

<Layout
  title={`${vacante.data.titulo} en ${vacante.data.empresa}`}
  description={vacante.data.descripcion}
  schema={jobSchema}
>
  <!-- Detail Top Header (Figma #6:348) -->
  <div class="bg-forest-900 text-white py-10 md:py-14 border-b border-forest-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-sage-300 mb-4">
        <a href={`${base}/vacantes`} class="hover:text-white transition-colors flex items-center gap-1">
          <span>←</span>
          <span>Vacantes</span>
        </a>
        <span>/</span>
        <span class="text-sand-50 truncate max-w-xs">{vacante.data.titulo}</span>
      </nav>

      <span class="text-xs font-bold uppercase tracking-wider text-gold-300 bg-white/10 px-3 py-1 rounded-pill mb-3 inline-block">
        OPORTUNIDAD FORMATIVA
      </span>
      <h1 class="font-serif text-3xl sm:text-5xl font-normal text-sand-50 mb-3">
        Una oportunidad para crecer haciendo.
      </h1>
      <p class="text-xs sm:text-sm text-sage-300">
        Publicación de formación supervisada en Panamá · Mentoría asignada desde el primer día
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Opportunity Details (Col 1-8) -->
      <div class="lg:col-span-8 space-y-8">
        <!-- Main Info Banner -->
        <div class="rounded-card border border-sand-500 bg-sand-50 p-6 sm:p-8">
          <div class="flex items-start justify-between gap-4 mb-4">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-full bg-forest-900 text-white font-serif font-bold text-xl flex items-center justify-center">
                {vacante.data.inicialEmpresa}
              </div>
              <div>
                <h2 class="text-sm font-bold text-forest-900">{vacante.data.empresa}</h2>
                <p class="text-xs text-sage-600">{vacante.data.ubicacion}</p>
              </div>
            </div>

            <span class="rounded-pill bg-terracotta-500/10 border border-terracotta-500/30 px-3.5 py-1 text-sm font-extrabold text-terracotta-600">
              {vacante.data.estipendio}
            </span>
          </div>

          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-forest-900 mb-4">
            {vacante.data.titulo}
          </h2>

          <div class="flex flex-wrap items-center gap-2 mb-6">
            <span class="rounded-pill bg-sand-200 px-3 py-1 text-xs font-semibold text-forest-900">
              {vacante.data.ruta}
            </span>
            <span class="rounded-pill bg-sand-200 px-3 py-1 text-xs font-semibold text-forest-900">
              {vacante.data.modalidad}
            </span>
            <span class="rounded-pill bg-forest-900/10 px-3 py-1 text-xs font-bold text-forest-900">
              ✓ Sin experiencia previa
            </span>
            <span class="rounded-pill bg-forest-900/10 px-3 py-1 text-xs font-bold text-forest-900">
              ✓ Tutor: {vacante.data.mentorRol}
            </span>
          </div>

          <!-- Section: Sobre la oportunidad -->
          <div class="space-y-6 pt-6 border-t border-sand-300">
            <div>
              <h3 class="font-serif text-lg font-bold text-forest-900 mb-2">Sobre la oportunidad</h3>
              <p class="text-xs sm:text-sm text-sage-700 leading-relaxed">
                {vacante.data.descripcion}
              </p>
            </div>

            <!-- Section: Lo que harías -->
            <div>
              <h3 class="font-serif text-lg font-bold text-forest-900 mb-2">Lo que harías en el equipo</h3>
              <ul class="space-y-2 text-xs sm:text-sm text-sage-700">
                {vacante.data.tareas.map((t) => (
                  <li class="flex items-start gap-2">
                    <span class="text-terracotta-500 font-bold">•</span>
                    <span>{t}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Section: Lo que aprenderás -->
            <div>
              <h3 class="font-serif text-lg font-bold text-forest-900 mb-2">Habilidades que desarrollarás</h3>
              <ul class="space-y-2 text-xs sm:text-sm text-sage-700">
                {vacante.data.aprendizaje.map((a) => (
                  <li class="flex items-start gap-2">
                    <span class="text-forest-900 font-bold">✓</span>
                    <span>{a}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Section: Requisitos formativos -->
            <div>
              <h3 class="font-serif text-lg font-bold text-forest-900 mb-2">Requisitos formativos</h3>
              <ul class="space-y-2 text-xs sm:text-sm text-sage-700">
                {vacante.data.requisitos.map((r) => (
                  <li class="flex items-start gap-2">
                    <span class="text-sage-500 font-bold">−</span>
                    <span>{r}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <!-- Markdown body extension if any -->
        <div class="prose prose-forest text-xs sm:text-sm text-sage-700 pt-4">
          <Content />
        </div>

        <!-- Mentor Requirement Banner (Figma #6:381) -->
        <div class="rounded-card bg-sand-200 border border-sand-500/80 p-5 flex items-center gap-3">
          <span class="text-forest-900 font-bold text-xl">✓</span>
          <p class="text-xs text-forest-900 font-semibold leading-relaxed">
            La empresa asigna una persona mentora dedicada ({vacante.data.mentorRol}) y confirma condiciones honestas de aprendizaje antes de recibir postulaciones en Umbral.
          </p>
        </div>
      </div>

      <!-- Application Panel (Figma #6:373) (Col 9-12) -->
      <aside class="lg:col-span-4 sticky top-24 space-y-4">
        <div class="rounded-card border border-sand-500 bg-sand-50 p-6 sm:p-7 shadow-lg shadow-forest-950/5">
          <span class="text-[10px] uppercase font-bold text-terracotta-600 block mb-2">
            POSTULACIÓN DIRECTA
          </span>
          <h3 class="font-serif text-xl font-bold text-forest-900 mb-2">
            ¿Te interesa aprender aquí?
          </h3>
          <p class="text-xs text-sage-700 leading-relaxed mb-6">
            Completa tu Perfil de Potencial o ingresa tus datos para postularte sin costo ni requisitos de experiencia.
          </p>

          <button
            type="button"
            id="openApplyModalBtn"
            class="w-full block text-center rounded-pill bg-terracotta-500 hover:bg-terracotta-600 py-3.5 text-xs font-bold text-white shadow-md shadow-terracotta-500/25 transition-all hover:scale-[1.02] active:scale-[0.98] mb-3"
          >
            Postularme a esta vacante
          </button>

          <button
            type="button"
            id="shareOpportunityBtn"
            class="w-full block text-center rounded-pill bg-sand-200 hover:bg-sand-300 py-2.5 text-xs font-bold text-forest-900 transition-colors"
          >
            Compartir oportunidad
          </button>

          <div class="mt-6 pt-5 border-t border-sand-300 text-center text-[11px] text-sage-600 space-y-1">
            <p>Publicado hace 2 días · Estipendio garantizado</p>
            <p>Proceso 100% gratuito para estudiantes</p>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <!-- Simulated Application Modal -->
  <div id="applyModal" class="hidden fixed inset-0 z-50 bg-forest-950/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="rounded-card bg-sand-50 border border-sand-500 max-w-md w-full p-6 sm:p-8 shadow-2xl relative animate-in fade-in zoom-in-95 duration-150">
      <button
        type="button"
        id="closeModalBtn"
        class="absolute top-4 right-4 text-sage-600 hover:text-forest-900 text-lg font-bold"
      >
        ✕
      </button>

      <span class="text-[10px] font-bold text-terracotta-600 uppercase mb-1 block">Postulación de Aprendizaje</span>
      <h3 class="font-serif text-xl font-bold text-forest-900 mb-2">
        Postular a {vacante.data.titulo}
      </h3>
      <p class="text-xs text-sage-700 mb-6">
        Tu información será evaluada por el equipo de {vacante.data.empresa} bajo el pacto de mentoría.
      </p>

      <form class="space-y-3.5" onsubmit="event.preventDefault(); alert('¡Postulación enviada con éxito! La empresa revisará tu Perfil de Potencial.'); document.getElementById('applyModal').classList.add('hidden');">
        <div>
          <label class="block text-xs font-bold text-forest-900 mb-1">Tu Nombre Completo</label>
          <input
            type="text"
            required
            placeholder="Ej. Ana Morales"
            class="w-full rounded-xl bg-white border border-sand-400 px-3.5 py-2 text-xs font-medium text-forest-900 focus:outline-none focus:border-forest-900"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-forest-900 mb-1">Correo Electrónico (Estudiantil o Personal)</label>
          <input
            type="email"
            required
            placeholder="ana.morales@utp.ac.pa"
            class="w-full rounded-xl bg-white border border-sand-400 px-3.5 py-2 text-xs font-medium text-forest-900 focus:outline-none focus:border-forest-900"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-forest-900 mb-1">Universidad y Carrera</label>
          <input
            type="text"
            required
            placeholder="Ej. UTP · Ingeniería Industrial (IV Año)"
            class="w-full rounded-xl bg-white border border-sand-400 px-3.5 py-2 text-xs font-medium text-forest-900 focus:outline-none focus:border-forest-900"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-forest-900 mb-1">¿Por qué te entusiasma aprender en este rol?</label>
          <textarea
            rows="3"
            required
            placeholder="Cuéntanos qué materias te han gustado o qué curiosidad tienes por este campo..."
            class="w-full rounded-xl bg-white border border-sand-400 px-3.5 py-2 text-xs font-medium text-forest-900 focus:outline-none focus:border-forest-900"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full rounded-pill bg-terracotta-500 hover:bg-terracotta-600 py-3 text-xs font-bold text-white transition-all mt-4"
        >
          Enviar mi Postulación Gratuita
        </button>
      </form>
    </div>
  </div>

  <script is:inline>
    const modal = document.getElementById('applyModal');
    const openBtn = document.getElementById('openApplyModalBtn');
    const closeBtn = document.getElementById('closeModalBtn');
    const shareBtn = document.getElementById('shareOpportunityBtn');

    if (openBtn && modal) {
      openBtn.addEventListener('click', () => modal.classList.remove('hidden'));
    }
    if (closeBtn && modal) {
      closeBtn.addEventListener('click', () => modal.classList.add('hidden'));
    }
    if (shareBtn) {
      shareBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href);
        alert('¡Enlace de la oportunidad copiado al portapapeles!');
      });
    }
  </script>
</Layout>
