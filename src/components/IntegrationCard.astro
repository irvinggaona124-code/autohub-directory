---
interface Props {
  titulo: string;
  slug: string;
  appA: string;
  appB: string;
  motor: string;
  casoDeUso: string;
  nodosEstimados: number;
  dificultad: string;
  tiempoConfiguracion: string;
}

const {
  titulo,
  slug,
  appA,
  appB,
  motor,
  casoDeUso,
  nodosEstimados,
  dificultad,
  tiempoConfiguracion,
} = Astro.props;
---

<div class="group relative flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-900/50 p-6 transition-all duration-200 hover:-translate-y-1 hover:border-brand-500/40 hover:bg-slate-900/80 hover:shadow-lg">
  <div>
    <!-- Apps connecting badge -->
    <div class="flex items-center gap-2 mb-4">
      <span class="rounded-lg bg-slate-800/90 px-3 py-1 text-xs font-semibold text-white border border-slate-700/60">
        {appA}
      </span>
      <span class="text-brand-400 font-bold text-xs">↔</span>
      <span class="rounded-lg bg-slate-800/90 px-3 py-1 text-xs font-semibold text-white border border-slate-700/60">
        {appB}
      </span>
      <span class="ml-auto rounded-md bg-brand-500/10 px-2 py-0.5 text-[11px] font-medium text-brand-400">
        con {motor}
      </span>
    </div>

    <!-- Title -->
    <h3 class="text-base font-bold text-white group-hover:text-brand-300 transition-colors mb-2 line-clamp-2">
      <a href={`/integraciones/${slug}`}>
        {titulo}
      </a>
    </h3>

    <!-- Use Case -->
    <p class="text-xs text-slate-400 leading-relaxed line-clamp-2 mb-4">
      {casoDeUso}
    </p>
  </div>

  <!-- Meta footer -->
  <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400">
    <div class="flex items-center gap-3">
      <span>⚙️ {nodosEstimados} nodos</span>
      <span>⏱️ {tiempoConfiguracion}</span>
    </div>
    <span class={`font-medium ${
      dificultad === 'Principiante' ? 'text-emerald-400' : dificultad === 'Intermedio' ? 'text-amber-400' : 'text-rose-400'
    }`}>
      {dificultad}
    </span>
  </div>
</div>
