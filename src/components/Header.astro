---
const currentPath = Astro.url.pathname;

const navItems = [
  { name: 'Directorio', href: '/directorio' },
  { name: 'Integraciones pSEO', href: '/integraciones' },
  { name: 'Alternativas Open-Source', href: '/alternativas' },
  { name: 'Plantillas n8n', href: '/plantillas', badge: 'Hot' },
];
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-slate-950/80 border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-indigo-400 flex items-center justify-center text-white font-bold text-xl shadow-lg shadow-brand-500/25 group-hover:scale-105 transition-transform">
        ⚡
      </div>
      <div>
        <span class="text-lg font-bold tracking-tight text-white group-hover:text-brand-300 transition-colors">
          Auto<span class="text-brand-400">Hub</span>
        </span>
        <span class="hidden sm:inline-block text-[10px] uppercase font-semibold tracking-wider text-slate-400 block -mt-1">
          Directorio IA & Workflows
        </span>
      </div>
    </a>

    <!-- Nav Links Desktop -->
    <nav class="hidden md:flex items-center gap-1">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`relative px-3.5 py-2 text-sm font-medium rounded-lg transition-colors flex items-center gap-1.5 ${
              isActive
                ? 'text-white bg-slate-800/80'
                : 'text-slate-300 hover:text-white hover:bg-slate-900'
            }`}
          >
            {item.name}
            {item.badge && (
              <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                {item.badge}
              </span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-3">
      <a
        href="/enviar"
        class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold rounded-lg bg-gradient-to-r from-brand-600 to-indigo-600 text-white hover:from-brand-500 hover:to-indigo-500 shadow-md shadow-brand-600/20 transition-all hover:shadow-brand-600/35 hover:-translate-y-0.5"
      >
        <span>+ Publicar Herramienta</span>
      </a>
    </div>
  </div>
</header>
