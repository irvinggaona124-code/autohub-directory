---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname;

const navItems = [
  { name: 'Vacantes', href: `${base}/vacantes` },
  { name: 'Perfil estudiante', href: `${base}/estudiantes` },
  { name: 'Empresa formadora', href: `${base}/empresas` },
  { name: 'Talento anónimo', href: `${base}/talento` },
  { name: 'Guía', href: `${base}/guia` },
];
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-sand-100/90 border-b border-sand-500/70 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href={`${base}/`} class="flex items-center gap-3 group">
      <!-- Arch Mark Icon (Figma EL-deb6a0bd) -->
      <div class="w-8 h-8 rounded-[14px] bg-forest-900 flex items-center justify-center text-white text-base font-bold shadow-sm group-hover:bg-forest-800 transition-colors">
        <span class="inline-block transform -translate-y-0.5">∩</span>
      </div>
      <span class="font-serif text-2xl font-bold tracking-tight text-forest-900 group-hover:text-forest-700 transition-colors">
        Umbral
      </span>
      <span class="hidden md:inline-block text-[11px] font-medium tracking-wide text-sage-700 uppercase ml-1">
        Panamá
      </span>
    </a>

    <!-- Nav Links Desktop -->
    <nav class="hidden lg:flex items-center gap-1">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== `${base}/` && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`px-4 py-2 text-sm font-medium rounded-pill transition-all ${
              isActive
                ? 'text-forest-900 font-semibold bg-sand-200'
                : 'text-sage-700 hover:text-forest-900 hover:bg-sand-200/60'
            }`}
          >
            {item.name}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions (Figma EL-3743580b & EL-174c046d) -->
    <div class="flex items-center gap-3">
      <!-- Outline Button -->
      <a
        href={`${base}/empresas#publicar`}
        class="hidden sm:inline-flex items-center justify-center px-4 py-2 text-xs font-bold rounded-pill bg-sand-50 border border-sand-500 text-forest-900 hover:border-forest-900 hover:bg-white shadow-sm transition-all active:scale-[0.98]"
      >
        Publicar vacante
      </a>

      <!-- Primary Forest Button -->
      <a
        href={`${base}/estudiantes`}
        class="inline-flex items-center justify-center px-5 py-2 text-xs font-bold rounded-pill bg-forest-900 text-white hover:bg-forest-800 shadow-sm transition-all active:scale-[0.98]"
      >
        Crear perfil
      </a>
    </div>
  </div>
</header>
