---
interface Props {
  titulo: string;
  slug: string;
  saasPropietario: string;
  alternativaOpenSource: string;
  categoria: string;
  ahorroEstimadoMensual: string;
  ventajasOpenSource: string[];
}

const {
  titulo,
  slug,
  saasPropietario,
  alternativaOpenSource,
  categoria,
  ahorroEstimadoMensual,
  ventajasOpenSource,
} = Astro.props;
---

<div class="group relative flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-900/50 p-6 transition-all duration-200 hover:-translate-y-1 hover:border-emerald-500/40 hover:bg-slate-900/80 hover:shadow-lg">
  <div>
    <!-- Top comparison bar -->
    <div class="flex items-center justify-between gap-2 mb-4">
      <span class="rounded-md bg-rose-500/10 px-2.5 py-1 text-xs font-semibold text-rose-400 border border-rose-500/20 line-through">
        {saasPropietario}
      </span>
      <span class="text-xs font-bold text-slate-500">frente a</span>
      <span class="rounded-md bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-400 border border-emerald-500/20">
        {alternativaOpenSource} (Open-Source)
      </span>
    </div>

    <!-- Title -->
    <h3 class="text-base font-bold text-white group-hover:text-emerald-300 transition-colors mb-2">
      <a href={`/alternativas/${slug}`}>
        {titulo}
      </a>
    </h3>

    <!-- Savings -->
    <div class="rounded-lg bg-emerald-500/10 border border-emerald-500/20 px-3 py-1.5 mb-4">
      <span class="text-xs font-semibold text-emerald-400">
        Ahorro promedio: {ahorroEstimadoMensual}
      </span>
    </div>

    <!-- Highlights -->
    <ul class="space-y-1.5 mb-6 text-xs text-slate-400">
      {ventajasOpenSource.slice(0, 3).map((v) => (
        <li class="flex items-start gap-1.5">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>{v}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
    <span class="text-xs text-slate-500 font-medium">{categoria}</span>
    <a
      href={`/alternativas/${slug}`}
      class="text-xs font-semibold text-brand-400 hover:text-brand-300 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
    >
      Ver comparativa completa →
    </a>
  </div>
</div>
