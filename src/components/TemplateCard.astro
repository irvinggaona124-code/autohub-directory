---
interface Props {
  titulo: string;
  slug: string;
  descripcionCorta: string;
  precio: number;
  precioOriginal?: number;
  motor: string;
  categoria: string;
  nodos: number;
  ahorroLaboralMensual: string;
  payhipUrl: string;
  destacado?: boolean;
}

const {
  titulo,
  slug,
  descripcionCorta,
  precio,
  precioOriginal,
  motor,
  categoria,
  nodos,
  ahorroLaboralMensual,
  payhipUrl,
  destacado = false,
} = Astro.props;
---

<div class={`relative flex flex-col justify-between rounded-2xl border p-6 transition-all duration-200 hover:-translate-y-1 hover:shadow-xl ${
  destacado
    ? 'border-brand-500/50 bg-gradient-to-b from-brand-950/40 to-slate-900/90 shadow-brand-500/10'
    : 'border-slate-800 bg-slate-900/60 hover:border-slate-700'
}`}>
  {destacado && (
    <div class="absolute -top-3 right-6 rounded-full bg-gradient-to-r from-brand-500 to-indigo-500 px-3 py-0.5 text-[11px] font-bold text-white shadow-md">
      Recomendado
    </div>
  )}

  <div>
    <!-- Badges header -->
    <div class="flex items-center justify-between gap-2 mb-4">
      <span class="inline-flex items-center gap-1 rounded-md bg-slate-800 px-2.5 py-1 text-xs font-medium text-slate-300">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-400"></span>
        {motor}
      </span>
      <span class="rounded-md bg-indigo-500/10 px-2 py-0.5 text-xs font-semibold text-indigo-400 border border-indigo-500/20">
        {nodos} nodos
      </span>
    </div>

    <!-- Title & Desc -->
    <h3 class="text-lg font-bold text-white group-hover:text-brand-300 transition-colors mb-2">
      <a href={`/plantillas/${slug}`} class="focus:outline-none">
        {titulo}
      </a>
    </h3>
    <p class="text-sm text-slate-400 leading-relaxed line-clamp-2 mb-4">
      {descripcionCorta}
    </p>

    <!-- Savings badge -->
    <div class="rounded-lg bg-emerald-500/10 border border-emerald-500/20 px-3 py-1.5 mb-6">
      <span class="text-xs font-semibold text-emerald-400">
        Ahorro estimado: {ahorroLaboralMensual}
      </span>
    </div>
  </div>

  <!-- Pricing & Action -->
  <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
    <div>
      <div class="flex items-baseline gap-1.5">
        <span class="text-2xl font-extrabold text-white">{precio} USD</span>
        {precioOriginal && (
          <span class="text-xs text-slate-500 line-through">{precioOriginal} USD</span>
        )}
      </div>
      <span class="text-[11px] text-slate-400">Pago único • Licencia de por vida</span>
    </div>

    <div class="flex gap-2">
      <a
        href={`/plantillas/${slug}`}
        class="rounded-lg bg-slate-800 px-3 py-2 text-xs font-medium text-slate-300 hover:bg-slate-700 hover:text-white transition-colors"
      >
        Detalles
      </a>
      <a
        href={payhipUrl}
        class="payhip-buy-button rounded-lg bg-brand-600 px-4 py-2 text-xs font-bold text-white hover:bg-brand-500 shadow-md shadow-brand-600/20 transition-all hover:shadow-brand-600/40"
      >
        Descargar
      </a>
    </div>
  </div>
</div>
